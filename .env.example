# Copy this file to .env and fill in your key
ANTHROPIC_API_KEY=your-key-here
# Optional
ANTHROPIC_MODEL=claude-sonnet-5
PORT=3000

# FREE alternative to Anthropic: Google Gemini has a free API tier with no
# card required. If GEMINI_API_KEY is set, it's used instead of Anthropic.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional: payments (leave blank to run without payments)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:3000

# Required for real login: any long random string
SESSION_SECRET=change-this-to-a-long-random-string

# Login-link emails, option A (use this on Render's free plan — it blocks SMTP ports):
# Brevo's HTTPS API. Free: 300 emails/day. Get a key at https://app.brevo.com (SMTP & API > API Keys)
# and verify your sender address under Senders & IP > Senders.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=TidyLedger

# Login-link emails, option B: plain SMTP (works on your own computer or a paid host, NOT Render free) (leave blank to print the link
# to the server console instead, which is fine for local testing)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
